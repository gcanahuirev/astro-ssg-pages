{
  "name": "astro-ssg-pages",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write",
    "cf:preview": "astro build && wrangler pages dev",
    "cf:deploy": "astro build && wrangler pages deploy",
    "ci": "bun biome:check && bun run check && bun run build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.6",
    "typescript": "^6.0.3",
    "wrangler": "^4.118.0"
  }
}
